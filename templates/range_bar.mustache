{{!
    @template local_tipbooking/range_bar

    Bar of the chosen range, with "Clear" and "Book range". Hidden until a slot is chosen;
    local_tipbooking/space_booking fills it. On small screens it stays at the bottom.

    Context variables required for this template: none.

    Example context (json):
    {}
}}
<div class="local_tipbooking-rangebar card mt-3" data-region="local_tipbooking-rangebar" hidden>
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <strong>{{#str}}range:title, local_tipbooking{{/str}}</strong>
            <span data-region="local_tipbooking-rangelabel" aria-live="polite"></span>
            <div class="small text-muted">{{#str}}range:hint, local_tipbooking{{/str}}</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-action="local_tipbooking-clear">
                {{#str}}range:clear, local_tipbooking{{/str}}
            </button>
            <button type="button" class="btn btn-primary" data-action="local_tipbooking-book">
                {{#str}}range:book, local_tipbooking{{/str}}
            </button>
        </div>
    </div>
</div>
