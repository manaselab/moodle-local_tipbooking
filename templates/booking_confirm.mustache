{{!
    @template local_tipbooking/booking_confirm

    Body of the modal that confirms a booking.

    Context variables required for this template:
    * spacename - Name of the space.
    * daylabel - The day.
    * rangelabel - The range in the time of the space.
    * duration - Length of the range.
    * timezone - Time zone of the space.
    * showlocal - Whether the reader is in another time zone.
    * locallabel - The range in the time of the reader.
    * usertimezone - Time zone of the reader.

    Example context (json):
    {
        "spacename": "Prusa MK4 3D printer",
        "daylabel": "Thursday, 3 December 2026",
        "rangelabel": "10:00–13:00",
        "duration": "3 h",
        "timezone": "Asia/Bishkek",
        "showlocal": true,
        "locallabel": "05:00–08:00",
        "usertimezone": "Europe/Madrid"
    }
}}
<dl class="row mb-3">
    <dt class="col-4">{{#str}}confirm:space, local_tipbooking{{/str}}</dt>
    <dd class="col-8">{{spacename}}</dd>
    <dt class="col-4">{{#str}}confirm:day, local_tipbooking{{/str}}</dt>
    <dd class="col-8">{{daylabel}}</dd>
    <dt class="col-4">{{#str}}confirm:range, local_tipbooking{{/str}}</dt>
    <dd class="col-8">{{rangelabel}} · {{duration}} · {{timezone}}</dd>
    {{#showlocal}}
        <dt class="col-4">{{#str}}confirm:yourtime, local_tipbooking{{/str}}</dt>
        <dd class="col-8">{{locallabel}} · {{usertimezone}}</dd>
    {{/showlocal}}
</dl>
<p class="mb-0 text-muted">{{#str}}confirm:note, local_tipbooking{{/str}}</p>
